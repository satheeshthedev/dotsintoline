# ---------- Database (Neon Postgres) ----------
# Netlify: create a Netlify DB (sets NETLIFY_DATABASE_URL automatically).
# Vercel: add the Neon integration under Storage (sets DATABASE_URL automatically).
# Local: paste your Neon connection string here.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------- Server ----------
PORT=3000
# Public URL of the site (used for Cashfree return URL, webhook and QR image links in emails).
# Must be https in production. For local testing keep http://localhost:3000
# On Netlify/Vercel this is detected automatically; set it if you use a custom domain.
BASE_URL=http://localhost:3000

# ---------- Admin ----------
ADMIN_PASSWORD=change-this-password
# Long random string used to sign admin sessions (e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-with-a-long-random-string

# ---------- Cashfree Payment Gateway ----------
# "sandbox" for testing, "production" for live payments
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# ---------- Brevo (transactional email) ----------
BREVO_API_KEY=your_brevo_api_key
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs)
MAIL_FROM_EMAIL=hello@yourdomain.com
MAIL_FROM_NAME=Dots into Line

# ---------- Booking ----------
# Minutes an unpaid booking holds a seat while the person pays
HOLD_MINUTES=20
INSTAGRAM_URL=https://www.instagram.com/dots.into_line/
